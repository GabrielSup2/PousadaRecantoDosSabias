# ============================================================
# Pousada Recanto dos Sábios — variáveis do backend
# Copie este arquivo para .env e preencha os valores.
# NUNCA envie o .env para o GitHub.
# ============================================================

ENVIRONMENT=development
APP_NAME=Pousada Recanto dos Sabios API
APP_HOST=0.0.0.0
APP_PORT=8000

# Segurança / JWT
JWT_SECRET=troque-por-uma-chave-longa-e-aleatoria
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# Firebase
FIREBASE_PROJECT_ID=seu-projeto-firebase
FIREBASE_CREDENTIALS_JSON_PATH=./firebase-service-account.json
# No deploy (Render), use a variável abaixo com o JSON inteiro:
# FIREBASE_CREDENTIALS_JSON={"type":"service_account","project_id":"..."}

# Seed (executado uma vez para criar o admin e os 8 quartos)
ADMIN_EMAIL=admin@pousadarecanto.com
ADMIN_PASSWORD=troque-esta-senha
ADMIN_NAME=Administrador da Pousada
